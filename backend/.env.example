# CareerPilot AI backend configuration (placeholders only — no secrets).
# Copy to backend/.env and fill in for your environment. All variables
# use the CAREERPILOT_ prefix. Real secrets must never be committed.

# Deployment tier: development | staging | production
CAREERPILOT_ENVIRONMENT=development

# Database. Leave unset to use the local SQLite dev database.
# In production set a PostgreSQL URL, e.g.:
# CAREERPILOT_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/careerpilot
# CAREERPILOT_DATABASE_URL=

# Object storage: local | s3
CAREERPILOT_STORAGE_BACKEND=local
# When STORAGE_BACKEND=s3 (requires boto3 installed):
# CAREERPILOT_S3_BUCKET=your-bucket-name
# CAREERPILOT_S3_REGION=us-east-1
# CAREERPILOT_S3_PREFIX=careerpilot
# CAREERPILOT_S3_ENDPOINT_URL=            # for S3-compatible providers

# Email delivery (notifications). Without an SMTP host, notifications
# are recorded but not sent.
# CAREERPILOT_SMTP_HOST=smtp.example.com
# CAREERPILOT_SMTP_PORT=587
# CAREERPILOT_SMTP_USERNAME=
# CAREERPILOT_SMTP_PASSWORD=
# CAREERPILOT_SMTP_USE_TLS=true
# CAREERPILOT_NOTIFICATION_FROM_ADDRESS=careerpilot@example.com

# Error reporting (optional). Sentry is inert unless a DSN is set.
# CAREERPILOT_SENTRY_DSN=
# CAREERPILOT_SENTRY_TRACES_SAMPLE_RATE=0.0

# Authentication tuning (optional; secure defaults apply).
# CAREERPILOT_SESSION_TTL_MINUTES=720
# CAREERPILOT_AUTH_PBKDF2_ITERATIONS=480000
